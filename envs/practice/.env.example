# Template for the isolated Supabase PRACTICE project's own env file.
# Copy this to envs/practice/.env (already git-ignored, same rule as the
# real .env) and fill in the practice project's own values — never the
# production ones from the real .env at the repo root. This directory
# is read ONLY by vite.practice.config.ts (npm run dev:practice); the
# real npm run dev never reads it.
#
# VITE_PRACTICE_TARGET must stay "true" — it's what makes
# src/shared/supabaseClient.ts refuse to start if these are missing, or
# if VITE_SUPABASE_URL ever matches the production project ref.
VITE_PRACTICE_TARGET=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
